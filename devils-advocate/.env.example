# Devils Advocate Agent - Environment Configuration Example
# Copy to .env for local overrides

# Execution mode: local | ci | agent
DEVILS_ADVOCATE_MODE=local

# Safe read-only inspection root directories (comma-separated relative or absolute paths)
DEVILS_ADVOCATE_WATCH_DIRS=../backend,../frontend,./wiki

# Minimum risk priority score threshold to surface finding (0.0 to 1.0)
DEVILS_ADVOCATE_ALERT_THRESHOLD=0.45

# Risk Prioritization Weights (must sum to roughly 1.0)
DEVILS_ADVOCATE_WEIGHT_IMPACT=0.35
DEVILS_ADVOCATE_WEIGHT_LIKELIHOOD=0.25
DEVILS_ADVOCATE_WEIGHT_EXPOSURE=0.15
DEVILS_ADVOCATE_WEIGHT_DETECTABILITY=0.15
DEVILS_ADVOCATE_WEIGHT_CONFIDENCE=0.10

# Safe Execution Safeguards: strictly forbid writing code or running non-whitelisted bash commands
DEVILS_ADVOCATE_READ_ONLY=true
DEVILS_ADVOCATE_ALLOWED_COMMANDS="git diff,git log,npm test -- --dryRun,tsc --noEmit"

# Optional External Issue / VCS integration (mocked by default)
GITHUB_TOKEN=ghp_mock_token_for_ci_sample_only
JIRA_API_URL=https://jira.example.internal
JIRA_API_KEY=mock_key_for_testing
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/MOCK/TOKEN/TEST
